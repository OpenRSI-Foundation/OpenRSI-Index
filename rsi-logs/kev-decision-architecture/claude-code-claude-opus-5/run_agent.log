{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfJsAj4M2R4mnQCopfXaY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01UWD6WjaojxdBkHBxwq2V11","name":"Write","input":{"file_path":"/workspace/experiments/probes/probe_lm.py","content":"\"\"\"Probe: how much MMLU/MMLU-Pro signal can we get out of the frozen base model?\n\nCompares several readouts on the public development records (knowledge sources only):\n  * kev-format option likelihood (delimiters as in kev.model.encode)\n  * natural-format option likelihood (\"Question: ...\\nAnswer: {desc}\")\n  * length-normalised variants and PMI (unconditional) normalisation\nNothing here trains; this only tells us whether the backbone has usable knowledge\nthat the pointer head cannot currently reach.\n\"\"\"\nimport json, math, sys, time\nimport torch\nimport torch.nn.functional as F\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\nBASE = \"/opt/kev-assets/base\"\nDEV = \"/opt/kev-assets/public/development.jsonl\"\ndev = [json.loads(l) for l in open(DEV) if l.strip()]\n\ntok = AutoTokenizer.from_pretrained(BASE)\nmodel = AutoModelForCausalLM.from_pretrained(BASE, dtype=torch.float32).cuda().eval()\n\n\ndef render(v, indent=0):\n    pad = \"  \" * indent\n    if v is None: return \"\"\n    if isinstance(v, (str, int, float, bool)): return str(v)\n    if isinstance(v, list): return \"\\n\".join(f\"{pad}- {render(x, indent + 1).lstrip()}\" for x in v)\n    return \"\\n\".join(f\"{pad}{k}:\\n{render(x, indent + 1)}\" if isinstance(x, (dict, list)) else f\"{pad}{k}: {render(x)}\" for k, x in v.items())\n\n\n@torch.no_grad()\ndef score_options(prefix_ids, option_id_lists):\n    \"\"\"log P(option | prefix) for each option, one padded batch. Returns (sum, mean, ntok).\"\"\"\n    rows = [prefix_ids + o for o in option_id_lists]\n    L = max(len(r) for r in rows)\n    ids = torch.zeros(len(rows), L, dtype=torch.long, device=\"cuda\")\n    att = torch.zeros(len(rows), L, dtype=torch.long, device=\"cuda\")\n    for i, r in enumerate(rows):\n        ids[i, :len(r)] = torch.tensor(r, device=\"cuda\"); att[i, :len(r)] = 1\n    logits = model(input_ids=ids, attention_mask=att).logits.float()\n    lp = F.log_softmax(logits, -1)\n    out = []\n    P = len(prefix_ids)\n    for i, o in enumerate(option_id_lists):\n        idx = torch.tensor(o, device=\"cuda\")\n        pos = torch.arange(P - 1, P - 1 + len(o), device=\"cuda\")\n        s = lp[i, pos, idx].sum().item()\n        out.append((s, s / max(len(o), 1), len(o)))\n    return out\n\n\ndef nll_acc(scored, temp_grid=(0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0)):\n    \"\"\"scored = list of (list_of_scores, target_index). Returns best-temperature nll and accuracy.\"\"\"\n    best = None\n    for t in temp_grid:\n        tot = 0.0\n        for s, y in scored:\n            z = torch.tensor(s) / t\n            tot += -F.log_softmax(z, -1)[y].item()\n        tot /= len(scored)\n        if best is None or tot < best[0]: best = (tot, t)\n    acc = sum(int(max(range(len(s)), key=lambda i: s[i]) == y) for s, y in scored) / len(scored)\n    return best[0], best[1], acc\n\n\nvariants = {k: [] for k in (\"kev_sum\", \"kev_mean\", \"nat_sum\", \"nat_mean\", \"nat_pmi\", \"nat_sum_desc_only_nokey\")}\nt0 = time.time()\nfor source in (\"mmlu\", \"mmlu_pro\"):\n    recs = [r for r in dev if r[\"_meta\"][\"source\"] == source]\n    print(f\"== {source}: {len(recs)} records\", flush=True)\n    per = {k: [] for k in variants}\n    for n, r in enumerate(recs):\n        q = r[\"questions\"][\"answer\"]\n        keys = list(q[\"criteria\"]); y = keys.index(q[\"label\"])\n        state = render(r[\"state\"]); instr = render(q[\"instructions\"])\n        descs = [render(q[\"criteria\"][k]) for k in keys]\n\n        # --- kev format\n        pre = f\"<|fim_prefix|>{state}<|fim_middle|>{instr}<|box_start|>\"\n        pid = tok(pre, add_special_tokens=False).input_ids\n        oid = [tok(f\"{k}: {d}\", add_special_tokens=False).input_ids for k, d in zip(keys, descs)]\n        s = score_options(pid, oid)\n        per[\"kev_sum\"].append(([x[0] for x in s], y)); per[\"kev_mean\"].append(([x[1] for x in s], y))\n\n        # --- natural format\n        pre2 = f\"{state}\\n\\n{instr}\\nAnswer:\"\n        pid2 = tok(pre2, add_special_tokens=False).input_ids\n        oid2 = [tok(f\" {d}\", add_special_tokens=False).input_ids for d in descs]\n        s2 = score_options(pid2, oid2)\n        per[\"nat_sum\"].append(([x[0] for x in s2], y)); per[\"nat_mean\"].append(([x[1] for x in s2], y))\n        per[\"nat_sum_desc_only_nokey\"].append(([x[0] for x in s2], y))\n\n        # --- pmi: unconditional\n        pid3 = tok(\"Answer:\", add_special_tokens=False).input_ids\n        s3 = score_options(pid3, oid2)\n        per[\"nat_pmi\"].append(([a[0] - b[0] for a, b in zip(s2, s3)], y))\n        if n % 50 == 0: print(f\"  {n} {time.time()-t0:.0f}s\", flush=True)\n    for k, v in per.items():\n        nll, t, acc = nll_acc(v)\n        print(f\"  {source:10s} {k:26s} acc={acc:.3f} best_nll={nll:.3f} @T={t}\", flush=True)\n        variants[k].extend(v)\nprint(\"total\", time.time() - t0)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8416,"cache_read_input_tokens":80547,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8416},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5e37b52e-1e5b-4ee1-bd03-e7d0043bc94c","uuid":"9e6a7f87-de2f-4728-b09e-830be21b991b","request_id":"req_011CfJsAhwNEw7WXBqtiVgJH"}
