{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfJsF6ZmEbF174XagE8uD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Hjk1Dk6Uo9mHPocYdLSeD2","name":"Write","input":{"file_path":"/workspace/experiments/probes/probe_letter.py","content":"\"\"\"Probe 2: letter-readout (MMLU-harness style) vs cloze on the frozen base.\n\nIf the base expresses its MCQ knowledge far better through \"Answer: <letter>\" than\nthrough option likelihood, the decision head needs an index-addressed path, not only\na content-matching pointer.\n\"\"\"\nimport json, time\nimport torch\nimport torch.nn.functional as F\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\nBASE = \"/opt/kev-assets/base\"\ndev = [json.loads(l) for l in open(\"/opt/kev-assets/public/development.jsonl\") if l.strip()]\ntok = AutoTokenizer.from_pretrained(BASE)\nmodel = AutoModelForCausalLM.from_pretrained(BASE, dtype=torch.float32).cuda().eval()\nLETTERS = [chr(ord(\"A\") + i) for i in range(26)]\n\n\ndef render(v, indent=0):\n    pad = \"  \" * indent\n    if v is None: return \"\"\n    if isinstance(v, (str, int, float, bool)): return str(v)\n    if isinstance(v, list): return \"\\n\".join(f\"{pad}- {render(x, indent + 1).lstrip()}\" for x in v)\n    return \"\\n\".join(f\"{pad}{k}:\\n{render(x, indent + 1)}\" if isinstance(x, (dict, list)) else f\"{pad}{k}: {render(x)}\" for k, x in v.items())\n\n\n@torch.no_grad()\ndef last_logits(text):\n    ids = torch.tensor([tok(text, add_special_tokens=False).input_ids], device=\"cuda\")\n    return model(input_ids=ids).logits[0, -1].float()\n\n\ndef nll_acc(scored, grid=(0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0, 8.0, 12.0, 20.0)):\n    best = None\n    for t in grid:\n        tot = sum(-F.log_softmax(torch.tensor(s) / t, -1)[y].item() for s, y in scored) / len(scored)\n        if best is None or tot < best[0]: best = (tot, t)\n    acc = sum(int(max(range(len(s)), key=lambda i: s[i]) == y) for s, y in scored) / len(scored)\n    return best[0], best[1], acc\n\n\n@torch.no_grad()\ndef score_options_cloze(prefix_ids, option_id_lists):\n    rows = [prefix_ids + o for o in option_id_lists]\n    L = max(len(r) for r in rows)\n    ids = torch.zeros(len(rows), L, dtype=torch.long, device=\"cuda\")\n    att = torch.zeros(len(rows), L, dtype=torch.long, device=\"cuda\")\n    for i, r in enumerate(rows):\n        ids[i, :len(r)] = torch.tensor(r, device=\"cuda\"); att[i, :len(r)] = 1\n    lp = F.log_softmax(model(input_ids=ids, attention_mask=att).logits.float(), -1)\n    P = len(prefix_ids)\n    out = []\n    for i, o in enumerate(option_id_lists):\n        pos = torch.arange(P - 1, P - 1 + len(o), device=\"cuda\")\n        s = lp[i, pos, torch.tensor(o, device=\"cuda\")].sum().item()\n        out.append((s, s / max(len(o), 1)))\n    return out\n\n\nfor source in (\"mmlu\", \"mmlu_pro\"):\n    recs = [r for r in dev if r[\"_meta\"][\"source\"] == source]\n    per = {k: [] for k in (\"letter_plain\", \"letter_subject\", \"letter_paren\", \"cloze_mean\", \"letter_plus_cloze\")}\n    t0 = time.time()\n    for r in recs:\n        q = r[\"questions\"][\"answer\"]\n        keys = list(q[\"criteria\"]); y = keys.index(q[\"label\"]); K = len(keys)\n        st = r[\"state\"]\n        question = st.get(\"question\", render(st)) if isinstance(st, dict) else render(st)\n        subject = (st.get(\"subject\") or st.get(\"category\") or \"\") if isinstance(st, dict) else \"\"\n        descs = [render(q[\"criteria\"][k]) for k in keys]\n        body = \"\\n\".join(f\"{LETTERS[i]}. {d}\" for i, d in enumerate(descs))\n\n        p1 = f\"{question}\\n{body}\\nAnswer:\"\n        z = last_logits(p1)\n        ids_sp = [tok(f\" {LETTERS[i]}\", add_special_tokens=False).input_ids[0] for i in range(K)]\n        per[\"letter_plain\"].append(([z[i].item() for i in ids_sp], y))\n\n        p2 = f\"The following are multiple choice questions (with answers) about {subject}.\\n\\n{question}\\n{body}\\nAnswer:\"\n        z2 = last_logits(p2)\n        per[\"letter_subject\"].append(([z2[i].item() for i in ids_sp], y))\n\n        p3 = f\"{question}\\n{body}\\nAnswer: (\"\n        z3 = last_logits(p3)\n        ids_np = [tok(LETTERS[i], add_special_tokens=False).input_ids[0] for i in range(K)]\n        per[\"letter_paren\"].append(([z3[i].item() for i in ids_np], y))\n\n        pid = tok(f\"{question}\\nAnswer:\", add_special_tokens=False).input_ids\n        oid = [tok(f\" {d}\", add_special_tokens=False).input_ids for d in descs]\n        cl = score_options_cloze(pid, oid)\n        per[\"cloze_mean\"].append(([c[1] for c in cl], y))\n        a = F.log_softmax(torch.tensor([z2[i].item() for i in ids_sp]) / 2.0, -1)\n        b = F.log_softmax(torch.tensor([c[1] for c in cl]) / 1.0, -1)\n        per[\"letter_plus_cloze\"].append(((a + b).tolist(), y))\n    print(f\"== {source} n={len(recs)} ({time.time()-t0:.0f}s)\")\n    for k, v in per.items():\n        nll, t, acc = nll_acc(v)\n        print(f\"  {k:20s} acc={acc:.3f} best_nll={nll:.3f} @T={t}\", flush=True)\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":976,"cache_read_input_tokens":91318,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":976},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5e37b52e-1e5b-4ee1-bd03-e7d0043bc94c","uuid":"fd44977e-5cae-4be2-81f0-4d184b92e75d","request_id":"req_011CfJsF65zQMdK3F6KD9rc1"}
