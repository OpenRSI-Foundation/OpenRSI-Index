| paste -sd+ | bc)\n[ \"$USED\" -lt 500 ] || fail \"GPUs still in use (${USED} MiB); training must exit before rsi-submit\"\n\necho \"5. artifact structure and manifest\"\nvalidate-candidate --json | grep -q '\"status\": \"artifact_structure_valid\"' || fail \"validate-candidate rejected the candidate\"\n\necho \"6. no symlinks, everything world-readable\"\n[ -z \"$(find /workspace/candidate -type l)\" ] || fail \"symlink under candidate/\"\n[ -z \"$(find /workspace/candidate -type f ! -perm -o+r)\" ] || fail \"file not world-readable\"\n[ -z \"$(find /workspace/candidate -type d ! -perm -o+rx)\" ] || fail \"directory not world-searchable\"\n[ -z \"$(find /workspace/candidate -name '__pycache__' -o -name '*.pyc')\" ] || fail \"stale bytecode could shadow an import\"\n\nif [ \"$1\" != \"--quick\" ]; then\n  echo \"7. behavioural contract (isolation, memory, parameter budget)\"\n  CUDA_VISIBLE_DEVICES=0 $PY \"$HERE/check_contract.py\" /workspace/candidate/checkpoint 2>/dev/null \\\n    | grep -q '\"status\": \"ok\"' || fail \"contract checks failed\"\n\n  echo \"8. adversarial request shapes\"\n  CUDA_VISIBLE_DEVICES=0 $PY \"$HERE/stress.py\" 2>/dev/null | grep -q \"STRESS OK\" || fail \"stress suite failed\"\n\n  echo \"9. Judge worker simulation (clean cwd, one GPU, budgets)\"\n  CUDA_VISIBLE_DEVICES=0 $PY \"$HERE/judge_sim.py\" 2>/dev/null | grep -q '\"status\": \"ok\"' || fail \"judge simulation failed\"\n\n  echo \"10. official public evaluator\"\n  $PY /opt/kev-runtime/evaluate_public.py --candidate /workspace/candidate 2>/dev/null \\\n    | $PY -c 'import json,sys; m=json.load(sys.stdin)[\"metrics\"]; print(f\"   dev reward {m[\\\"reward\\\"]:.4f}\")'\nfi\necho \"PREFLIGHT OK — safe to run rsi-submit\"\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":882,"cache_read_input_tokens":742750,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1