")","+                                      if k in head))"," "," "," if __name__ == \"__main__\":"]}],"originalFile":"\"\"\"Assemble a two-member ensemble checkpoint from a letter member and a pointer member.\n\n    python build_ensemble.py <letter_ckpt> <pointer_ckpt> <out_dir>\n\nLayout written (the top-level files keep the reference's names so the contract check and the\nentrypoint find them; the second member lives in pointer/):\n\n    out/head.pt                        letter head + pointer head + mixture/calibration buffers\n    out/adapter_config.json            letter member adapter\n    out/adapter_model.safetensors\n    out/pointer/adapter_config.json    pointer member adapter\n    out/pointer/adapter_model.safetensors\n\"\"\"\nimport json\nimport shutil\nimport sys\nfrom pathlib import Path\n\nimport torch\n\n\ndef main(letter_dir, pointer_dir, out_dir):\n    letter_dir, pointer_dir, out = Path(letter_dir), Path(pointer_dir), Path(out_dir)\n    if out.exists():\n        raise FileExistsError(out)\n    out.mkdir(parents=True)\n    letter = torch.load(letter_dir / \"head.pt\", map_location=\"cpu\", weights_only=True)\n    pointer = torch.load(pointer_dir / \"head.pt\", map_location=\"cpu\", weights_only=True)\n    if letter.get(\"architecture\") != \"kev-decision-v2\":\n        raise ValueError(f\"{letter_dir} is not a kev-decision-v2 checkpoint\")\n    for name in (\"adapter_config.json\", \"adapter_model.safetensors\"):\n        shutil.copy2(letter_dir / name, out / name)\n        (out / \"pointer\").mkdir(exist_ok=True)\n        shutil.copy2(pointer_dir / name, out / \"pointer\" / name)\n    for name in (\"tokenizer.json\", \"tokenizer_config.json\"):\n        if (letter_dir / name).is_file():\n            shutil.copy2(letter_dir / name, out / name)\n    head = {\n        \"architecture\": \"kev-decision-ensemble\",\n        \"base\": \"Qwen/Qwen2.5-0.5B\",\n        \"head\": letter[\"head\"],\n        \"pointer_head\": pointer[\"head\"],\n        \"hea