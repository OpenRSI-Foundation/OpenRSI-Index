{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfHJpjWqtvQVqbiyoydyF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DQt3REWDZrvBUbioWFLGAu","name":"Write","input":{"file_path":"/workspace/experiments/probe_knowledge.py","content":"\"\"\"Probe: how much MCQ signal does the frozen Qwen2.5-0.5B base give via option likelihood?\n\nCompares scoring formats on public development data (selection only, never training).\n\"\"\"\nimport json, math, sys, argparse\nfrom collections import defaultdict\nimport torch\nimport torch.nn.functional as F\nfrom transformers import AutoModelForCausalLM, AutoTokenizer\n\nBASE = \"/opt/kev-assets/base\"\nsys.path.insert(0, \"/workspace/candidate\")\nfrom kev.api import SystemOneRequest, to_record, render\n\n\ndef load(dtype=torch.float32, device=\"cuda:1\"):\n    tok = AutoTokenizer.from_pretrained(BASE)\n    lm = AutoModelForCausalLM.from_pretrained(BASE, dtype=dtype).to(device).eval()\n    return tok, lm\n\n\n@torch.no_grad()\ndef score_continuations(tok, lm, device, prefix, conts, maxlen=1600):\n    \"\"\"log p(cont | prefix) for each continuation, one padded batch. Returns (sum, count) per cont.\"\"\"\n    pre = tok(prefix, add_special_tokens=False).input_ids\n    rows, spans = [], []\n    for c in conts:\n        ct = tok(c, add_special_tokens=False).input_ids\n        ids = (pre + ct)[-maxlen:]\n        spans.append(len(ct))\n        rows.append(ids)\n    L = max(len(r) for r in rows)\n    inp = torch.zeros(len(rows), L, dtype=torch.long, device=device)\n    att = torch.zeros(len(rows), L, dtype=torch.long, device=device)\n    for i, r in enumerate(rows):\n        inp[i, : len(r)] = torch.tensor(r, device=device)\n        att[i, : len(r)] = 1\n    out = lm(input_ids=inp, attention_mask=att).logits.float()\n    lp = F.log_softmax(out, -1)\n    res = []\n    for i, (r, n) in enumerate(zip(rows, spans)):\n        tgt = torch.tensor(r[len(r) - n:], device=device)\n        idx = torch.arange(len(r) - n - 1, len(r) - 1, device=device)\n        res.append((lp[i, idx].gather(-1, tgt[:, None]).sum().item(), n))\n    return res\n\n\n@torch.no_grad()\ndef score_letters(tok, lm, device, prompt, letters):\n    ids = tok(prompt, add_special_tokens=False).input_ids\n    out = lm(input_ids=torch.tensor([ids], device=device)).logits[0, -1].float()\n    lp = F.log_softmax(out, -1)\n    vals = []\n    for L in letters:\n        cands = [tok(f\" {L}\", add_special_tokens=False).input_ids, tok(L, add_special_tokens=False).input_ids]\n        best = max(lp[c[0]].item() for c in cands if len(c) >= 1)\n        vals.append(best)\n    return vals\n\n\ndef nll_acc(scores, target, temp=1.0):\n    t = torch.tensor(scores) / temp\n    p = F.softmax(t, -1)\n    return -math.log(max(p[target].item(), 1e-9)), int(int(p.argmax()) == target)\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--device\", default=\"cuda:1\")\n    ap.add_argument(\"--sources\", default=\"mmlu,mmlu_pro,sciq\")\n    ap.add_argument(\"--limit\", type=int, default=200)\n    args = ap.parse_args()\n    tok, lm = load(device=args.device)\n    dev = [json.loads(l) for l in open(\"/opt/kev-assets/public/development.jsonl\")]\n    want = set(args.sources.split(\",\"))\n    by = defaultdict(list)\n    for r in dev:\n        if r[\"_meta\"][\"source\"] in want:\n            by[r[\"_meta\"][\"source\"]].append(r)\n\n    methods = [\"sum\", \"mean\", \"letter\", \"mean_unc\"]\n    results = defaultdict(lambda: defaultdict(list))\n    for src, recs in by.items():\n        for r in recs[: args.limit]:\n            state = render(r[\"state\"])\n            for qid, q in r[\"questions\"].items():\n                if q[\"type\"] != \"choice\":\n                    continue\n                keys = list(q[\"criteria\"])\n                target = keys.index(q[\"label\"])\n                opts = [render(v) if v else k for k, v in q[\"criteria\"].items()]\n                instr = render(q[\"instructions\"])\n                prefix = f\"{state}\\n{instr}\\nAnswer:\"\n                sc = score_continuations(tok, lm, args.device, prefix, [f\" {o}\" for o in opts])\n                unc = score_continuations(tok, lm, args.device, \"Answer:\", [f\" {o}\" for o in opts])\n                results[src][\"sum\"].append(([s for s, n in sc], target))\n                results[src][\"mean\"].append(([s / n for s, n in sc], target))\n                results[src][\"mean_unc\"].append(([(s - u) / n for (s, n), (u, _) in zip(sc, unc)], target))\n                letters = [chr(ord(\"A\") + i) for i in range(len(opts))]\n                body = \"\\n\".join(f\"{L}. {o}\" for L, o in zip(letters, opts))\n                prompt = f\"{state}\\n{instr}\\n{body}\\nAnswer:\"\n                results[src][\"letter\"].append((score_letters(tok, lm, args.device, prompt, letters), target))\n\n    report = {}\n    for src in results:\n        report[src] = {}\n        for m in methods:\n            rows = results[src][m]\n            best = None\n            for temp in [0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 5.0, 8.0, 15.0, 30.0]:\n                nlls, accs = zip(*[nll_acc(s, t, temp) for s, t in rows])\n                mean = sum(nlls) / len(nlls)\n                if best is None or mean < best[1]:\n                    best = (temp, mean, sum(accs) / len(accs))\n            report[src][m] = {\"temp\": best[0], \"nll\": round(best[1], 4), \"acc\": round(best[2], 4), \"n\": len(rows)}\n        report[src][\"uniform_nll\"] = round(sum(math.log(len(s)) for s, _ in results[src][\"sum\"]) / len(results[src][\"sum\"]), 4)\n    print(json.dumps(report, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":131,"cache_creation_input_tokens":305,"cache_read_input_tokens":95390,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":305},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"560ecfb8-442b-496c-96fc-76248767870b","uuid":"d0e147e4-a664-4f79-aa7f-0e794e0f1d6b","request_id":"req_011CfHJpjFDRLZDDfchHrWCx"}
