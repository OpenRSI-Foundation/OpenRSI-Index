d (MMLU 1.231 -> 1.209, MMLU-Pro 2.151 -> 2.133,\n        emotion 1.224 -> 1.175). It is stored with the checkpoint, so serving needs no corpus access.\n        \"\"\"''')\np.write_text(s)\n\np = pathlib.Path(\"kev/xensemble.py\"); s = p.read_text()\ns = s.replace('''    def __init__(self, tokenizer, model, combine=\"geometric\", letter_shifts=12):\n        self.tokenizer = tokenizer\n        self.model = model\n        self.combine = combine\n        self.letter_shifts = letter_shifts''',\n              '''    def __init__(self, tokenizer, model, combine=\"geometric\", letter_shifts=12, letter_prefix=()):\n        self.tokenizer = tokenizer\n        self.model = model\n        self.combine = combine\n        self.letter_shifts = letter_shifts\n        self.letter_prefix = tuple(letter_prefix)''')\ns = s.replace('''                letters = core.letter_logprobs_symmetric(tok, probes, record[\"state\"], self.letter_shifts)''',\n              '''                letters = core.letter_logprobs_symmetric(tok, probes, record[\"state\"], self.letter_shifts,\n                                                         prefix=self.letter_prefix)''')\ns = s.replace('''    return Predictor(tok, ensemble, combine=spec.get(\"combine\", \"geometric\"),\n                     letter_shifts=int(spec.get(\"letter_shifts\", 12)))''',\n              '''    demos = checkpoint / \"letter_demos.json\"\n    prefix = json.loads(demos.read_text())[\"tokens\"] if demos.is_file() else []\n    return Predictor(tok, ensemble, combine=spec.get(\"combine\", \"geometric\"),\n                     letter_shifts=int(spec.get(\"letter_shifts\", 12)), letter_prefix=prefix)''')\ns = s.replace('''    calibration.json       per-bucket temperature, floor and letter-channel weight''',\n              '''    calibration.json       per-bucket temperature, floor and letter-channel weight\n    letter_demos.json      token [REDACTED] of the fixed in-context demonstration prefix''')\np.write_text(s); print(\"ok\")\nPY