{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfKmQwGkV9tmvuZaF3uWX","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FWdsxmnqfJhioskn5zokAQ","name":"Write","input":{"file_path":"/workspace/experiments/judge_sim.py","content":"\"\"\"Simulate the Judge's inference worker as closely as this environment allows.\n\nLoads from a clean interpreter, from an unrelated working directory, with only the candidate on\nsys.path, one visible GPU, and feeds requests one at a time — then checks the budgets the Judge\nenforces (180 s to load, 45 s per request, 20 min total, 16 GiB peak).\n\"\"\"\nimport importlib.util\nimport json\nimport os\nimport sys\nimport time\nfrom pathlib import Path\n\nCANDIDATE = \"/workspace/candidate\"\nLOAD_BUDGET, REQUEST_BUDGET, WORKER_BUDGET, MEMORY_BUDGET = 180.0, 45.0, 20 * 60, 16.0\n\nspec = importlib.util.spec_from_file_location(\"contract\", \"/opt/kev-runtime/contract.py\")\ncontract = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(contract)\n\n\ndef main():\n    os.chdir(\"/tmp\")                      # the Judge does not run from the candidate directory\n    import torch\n    torch.manual_seed(0)\n    torch.backends.cuda.matmul.allow_tf32 = False\n    torch.backends.cudnn.allow_tf32 = False\n    torch.backends.cuda.enable_flash_sdp(False)\n    torch.backends.cuda.enable_mem_efficient_sdp(False)\n    sys.path.insert(0, CANDIDATE)\n    espec = importlib.util.spec_from_file_location(\"_cand\", Path(CANDIDATE) / \"entrypoint.py\")\n    module = importlib.util.module_from_spec(espec)\n    sys.modules[\"_cand\"] = module\n\n    started = time.time()\n    espec.loader.exec_module(module)\n    predictor = module.load(str(Path(CANDIDATE) / \"checkpoint\"), \"cuda:0\")\n    if not isinstance(predictor.model, torch.nn.Module):\n        raise TypeError(\".model must be a torch.nn.Module\")\n    predictor.model.eval()\n    load_seconds = time.time() - started\n\n    records = [json.loads(l) for l in Path(\"/opt/kev-assets/public/development.jsonl\").read_text().splitlines() if l.strip()]\n    torch.cuda.reset_peak_memory_stats()\n    slowest, total, failures = 0.0, 0.0, []\n    with torch.inference_mode():\n        for record in records:\n            request = contract.clean_request(record)\n            t0 = time.time()\n            response = predictor.predict(request)\n            elapsed = time.time() - t0\n            slowest = max(slowest, elapsed)\n            total += elapsed\n            try:\n                contract.validate_prediction(request, response)\n            except contract.CandidateInvalid as exc:\n                failures.append(f\"{record['_meta']['id']}: {exc.errors}\")\n    peak = torch.cuda.max_memory_allocated() / 2**30\n    scaled = total / len(records) * 2068          # the hidden workload's question count\n\n    checks = {\n        \"load within 180 s\": load_seconds <= LOAD_BUDGET,\n        \"slowest request within 45 s\": slowest <= REQUEST_BUDGET,\n        \"projected worker time within 20 min\": load_seconds + scaled <= WORKER_BUDGET,\n        \"peak memory within 16 GiB\": peak <= MEMORY_BUDGET,\n        \"every prediction valid\": not failures,\n    }\n    print(json.dumps({\n        \"uid\": os.getuid(), \"cwd\": os.getcwd(), \"visible_gpus\": os.environ.get(\"CUDA_VISIBLE_DEVICES\", \"all\"),\n        \"load_seconds\": round(load_seconds, 1), \"requests\": len(records),\n        \"slowest_request_s\": round(slowest, 3), \"mean_request_s\": round(total / len(records), 4),\n        \"projected_worker_s\": round(load_seconds + scaled, 1), \"peak_gib\": round(peak, 2),\n        \"invalid_predictions\": failures[:3],\n        \"checks\": checks, \"status\": \"ok\" if all(checks.values()) else \"FAILED\",\n    }, indent=2))\n    return 0 if all(checks.values()) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2781,"cache_read_input_tokens":721442,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2781},"output_tokens":7,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5e37b52e-1e5b-4ee1-bd03-e7d0043bc94c","uuid":"0fd3d318-fd83-4775-b020-80fac06c33a7","request_id":"req_011CfKmQvf3MYRcBBxzkd28Q"}
