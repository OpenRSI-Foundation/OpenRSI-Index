+
+class InteractionPointerHead(nn.Module):
+    """Pointer logits plus a permutation-equivariant DeepSets residual.
+
+    The pointer preserves the reference comparison path.  The zero-initialized
+    residual can additionally express unary option quality, compatibility with
+    the decision state, and deviation from the option-set mean without tying
+    behavior to a fixed number of options.
+    """
+    def __init__(self, d, dp=256, dropout=0.0, representation_layers=1):
+        super().__init__()
+        self.pointer = PointerHead(d, dp, dropout=dropout)
+        self.representation_layers = representation_layers
+        if representation_layers > 1:
+            self.layer_logits = nn.Parameter(torch.zeros(representation_layers))
+        self.norm = nn.LayerNorm(d)
+        self.option = nn.Linear(d, dp)
+        self.decision = nn.Linear(d, dp)
+        self.residual = nn.Sequential(
+            nn.LayerNorm(4 * dp),
+            nn.Linear(4 * dp, dp),
+            nn.SiLU(),
+            nn.Linear(dp, 1),
+        )
+        # Begin as the reference pointer rather than injecting random residual
+        # logits; gradients reach the final layer immediately and then the
+        # interaction features on subsequent updates.
+        nn.init.zeros_(self.residual[-1].weight)
+        nn.init.zeros_(self.residual[-1].bias)
+
+    def forward(self, h_decide, h_opts):
+        options = F.silu(self.option(self.norm(h_opts)))
+        decision = F.silu(self.decision(self.norm(h_decide))).expand_as(options)
+        context = options.mean(0, keepdim=True).expand_as(options)
+        features = torch.cat((options, options * decision, options - context, options * context), -1)
+        return self.pointer(h_decide, h_opts) + self.residual(features).squeeze(-1)
 
 
