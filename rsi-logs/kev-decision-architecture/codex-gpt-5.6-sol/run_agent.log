+"""Add a third switched adapter/head to an existing dual-adapter checkpoint."""
+
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint")
+    parser.add_argument("--weight", type=float, required=True)
+    parser.add_argument("--noul-weight", type=float)
+    parser.add_argument("--choice-weight", type=float)
+    parser.add_argument("--score-weight", type=float)
+    parser.add_argument("--noul", type=float, required=True)
+    parser.add_argument("--choice", type=float, required=True)
+    parser.add_argument("--score", type=float, required=True)
+    args = parser.parse_args()
+    if not 0 <= args.weight <= 1:
+        raise ValueError("weight must be in [0, 1]")
+    checkpoint = Path(args.checkpoint)
+    manifest_path = checkpoint / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    if not isinstance(manifest.get("ensemble"), dict):
+        raise ValueError("checkpoint must already declare the dual ensemble")
+    manifest["ensemble"]["third"] = {
+        "adapter": "third_adapter",
+        "head": "third_head.pt",
+        "temperatures": {"noul": args.noul, "choice": args.choice, "score": args.score},
+        "weight": args.weight,
+    }
+    type_weights = (args.noul_weight, args.choice_weight, args.score_weight)
+    if any(value is not None for value in type_weights):
+        if any(value is None or not 0 <= value <= 1 for value in type_weights):
+            raise ValueError("all per-type weights must be supplied in [0, 1]")
+        manifest["ensemble"]["third"]["weight_by_type"] = dict(
+            zip(("noul", "choice", "score"), type_weights))
+    manifest["checkpoint_files"] = sorted(
+        path.relative_to(checkpoint).as_posix()
+        for path in checkpoint.rglob("*")
+        if path.is_file() and path.name != "manifest.json"
+    )
+    temporary = checkpoint / ".manifest.json.tmp"
+    temporary.write_text(json.dumps(manifest, indent=2, allow_nan=False) + "\n")
+    temporary.chmod(0o644)
+    temporary.replace(manifest_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/paired_expert_probe.py b/experiments/paired_expert_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..877719b6b5dfefa794bdc613a776767c687687b1
--- /dev/null
+++ b/experiments/paired_expert_probe.py
@@ -0,0 +1,90 @@
+"""Probe a choice-only mixture of two experts over an existing ensemble."""
+
+import argparse
+import gc
+import importlib.util
+import itertools
+import json
+import sys
+
+import torch
+
+sys.path.insert(0, "/workspace/candidate")
+import entrypoint
+
+spec = importlib.util.spec_from_file_location("public_contract", "/opt/kev-runtime/contract.py")
+contract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(contract)
+
+PUBLIC = "/opt/kev-assets/public/development.jsonl"
+
+
+def predict(checkpoint, device, records):
+    predictor = entrypoint.load(checkpoint, device)
+    output = []
+    with torch.inference_mode():
+        for record in records:
+            question_id, question = next(iter(record["questions"].items()))
+            result = predictor.predict(contract.clean_request(record))["probabilities"][question_id]
+            output.append([result[key] for key in contract.option_keys(question)])
+    del predictor
+    gc.collect()
+    torch.cuda.empty_cache()
+    print(f"predicted {checkpoint}", flush=True)
+    return output
+
+
+def response(record, values):
+    question_id, question = next(iter(record["questions"].items()))
+    return {"probabilities": {question_id: dict(zip(contract.option_keys(question), values))}}
+
+
+def parse_grid(value):
+    return tuple(float(item) for item in value.split(","))
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("base")
+    parser.add_argument("left_expert")
+    parser.add_argument("right_expert")
+    parser.add_argument("--outer-weights", default="0.4,0.46,0.52,0.58,0.64")
+    parser.add_argument("--expert-weights", default="0.3,0.4,0.5,0.6,0.7")
+    parser.add_argument("--device", default="cuda:0")
+    args = parser.parse_args()
+
+    records = [json.loads(line) for line in open(PUBLIC) if line.strip()]
+    base = predict(args.base, args.device, records)
+    left = predict(args.left_expert, args.device, records)
+    right = predict(args.right_expert, args.device, records)
+    reports = []
+    for outer_weight, expert_weight in itertools.product(
+            parse_grid(args.outer_weights), parse_grid(args.expert_weights)):
+        mixed = []
+        for record, base_values, left_values, right_values in zip(records, base, left, right):
+            _, question = next(iter(record["questions"].items()))
+            if question["type"] != "choice":
+                mixed.append(base_values)
+                continue
+            expert = [(1 - expert_weight) * x + expert_weight * y
+                      for x, y in zip(left_values, right_values)]
+            mixed.append([(1 - outer_weight) * x + outer_weight * y
+                          for x, y in zip(base_values, expert)])
+        metrics = contract.score_records(
+            records, [response(record, values) for record, values in zip(records, mixed)])
+        reports.append({
+            "outer_weight": outer_weight,
+            "right_expert_weight": expert_weight,
+            "reward": metrics["reward"],
+            "macro_nll": metrics["macro_nll"],
+            "knowledge_nll": metrics["groups"]["knowledge"]["nll"],
+            "other_nll": metrics["groups"]["other"]["nll"],
+            "knowledge_accuracy": metrics["groups"]["knowledge"]["accuracy"],
+            "other_accuracy": metrics["groups"]["other"]["accuracy"],
+        })
+    reports.sort(key=lambda item: item["macro_nll"])
+    print(json.dumps(reports, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/set_calibration.py b/experiments/set_calibration.py
new file mode 100644
index 0000000000000000000000000000000000000000..3150473c6704835752fc93ed9e8241901a53eb00
--- /dev/null
+++ b/experiments/set_calibration.py
@@ -0,0 +1,47 @@
+"""Set serving-only per-question-type temperatures in a Kev checkpoint."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+import torch
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint")
+    parser.add_argument("--noul", type=float, required=True)
+    parser.add_argument("--choice", type=float, required=True)
+    parser.add_argument("--score", type=float, required=True)
+    args = parser.parse_args()
+    values = {"noul": args.noul, "choice": args.choice, "score": args.score}
+    if any(not math.isfinite(value) or value <= 0 for value in values.values()):
+        raise ValueError("temperatures must be finite and positive")
+
+    checkpoint = Path(args.checkpoint)
+    head_path = checkpoint / "head.pt"
+    payload = torch.load(head_path, map_location="cpu", weights_only=True)
+    payload["inference_temperatures"] = values
+    temporary = checkpoint / ".head.pt.tmp"
+    torch.save(payload, temporary)
+    temporary.chmod(0o644)
+    temporary.replace(head_path)
+
+    manifest_path = checkpoint / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    manifest.setdefault("training", {}).setdefault("hyperparameters", {})[
+        "inference_temperature_by_type"
+    ] = values
+    manifest["serving_calibration"] = {
+        "method": "per-question-type temperature scaling",
+        "temperatures": values,
+    }
+    temporary = checkpoint / ".manifest.json.tmp"
+    temporary.write_text(json.dumps(manifest, indent=2, allow_nan=False) + "\n")
+    temporary.chmod(0o644)
+    temporary.replace(manifest_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/temperature_probe.py b/experiments/temperature_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..e0a896f7723561455d93eb1085377e5535102855
--- /dev/null
+++ b/experiments/temperature_probe.py
@@ -0,0 +1,60 @@
+"""Read-only public-dev temperature diagnostic for a trained checkpoint."""
+import argparse
+import importlib.util
+import json
+import sys
+
+import torch
+
+sys.path.insert(0, "/workspace/candidate")
+import entrypoint
+
+spec = importlib.util.spec_from_file_location("public_contract", "/opt/kev-runtime/contract.py")
+contract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(contract)
+
+PUBLIC = "/opt/kev-assets/public/development.jsonl"
+
+
+def response(record, probabilities):
+    question_id, question = next(iter(record["questions"].items()))
+    return {"probabilities": {question_id: dict(zip(contract.option_keys(question), probabilities))}}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint")
+    parser.add_argument("--temperatures", default="0.75,1,1.15,1.3,1.5,1.75,2",
+                        help="comma-separated multipliers of the checkpoint temperature")
+    parser.add_argument("--device", default="cuda:0")
+    args = parser.parse_args()
+    temperatures = tuple(float(value) for value in args.temperatures.split(","))
+    if not temperatures or any(not 0 < value < 100 for value in temperatures):
+        raise ValueError("temperatures must be positive finite values")
+    records = [json.loads(line) for line in open(PUBLIC) if line.strip()]
+    predictor = entrypoint.load(args.checkpoint, args.device)
+    raw = []
+    with torch.inference_mode():
+        for record in records:
+            prediction = predictor.predict(contract.clean_request(record))
+            question_id, question = next(iter(record["questions"].items()))
+            raw.append([prediction["probabilities"][question_id][key] for key in contract.option_keys(question)])
+    reports = []
+    for temperature in temperatures:
+        transformed = []
+        for values in raw:
+            powered = [max(value, 1e-30) ** (1 / temperature) for value in values]
+            total = sum(powered)
+            transformed.append([value / total for value in powered])
+        metrics = contract.score_records(records, [response(record, values) for record, values in zip(records, transformed)])
+        reports.append({"temperature": temperature, "reward": metrics["reward"], "macro_nll": metrics["macro_nll"],
+                        "knowledge_nll": metrics["groups"]["knowledge"]["nll"],
+                        "other_nll": metrics["groups"]["other"]["nll"],
+                        "knowledge_accuracy": metrics["groups"]["knowledge"]["accuracy"],
+                        "other_accuracy": metrics["groups"]["other"]["accuracy"],
+                        "unknown": metrics.get("unknowable")})
+    print(json.dumps(reports, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/type_temperature_probe.py b/experiments/type_temperature_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..b9445ffa939ab448c3db8057b88c61f77d1cccbb
--- /dev/null
+++ b/experiments/type_temperature_probe.py
@@ -0,0 +1,97 @@
+"""Grid-search type-specific temperature multipliers on public development."""
+
+import argparse
+import importlib.util
+import itertools
+import json
+import math
+import sys
+
+import torch
+
+sys.path.insert(0, "/workspace/candidate")
+import entrypoint
+
+spec = importlib.util.spec_from_file_location("public_contract", "/opt/kev-runtime/contract.py")
+contract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(contract)
+
+PUBLIC = "/opt/kev-assets/public/development.jsonl"
+TYPES = ("noul", "choice", "score")
+
+
+def response(record, probabilities):
+    question_id, question = next(iter(record["questions"].items()))
+    return {"probabilities": {question_id: dict(zip(contract.option_keys(question), probabilities))}}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint")
+    parser.add_argument("--grid", default="0.75,0.85,0.95,1,1.05,1.15,1.25")
+    parser.add_argument("--noul-grid", default="")
+    parser.add_argument("--choice-grid", default="")
+    parser.add_argument("--score-grid", default="")
+    parser.add_argument("--optimize", action="store_true")
+    parser.add_argument("--opt-min", type=float, default=0.5)
+    parser.add_argument("--opt-max", type=float, default=1.5)
+    parser.add_argument("--device", default="cuda:0")
+    args = parser.parse_args()
+    grid = tuple(float(value) for value in args.grid.split(","))
+    grids = {
+        "noul": tuple(float(value) for value in args.noul_grid.split(",")) if args.noul_grid else grid,
+        "choice": tuple(float(value) for value in args.choice_grid.split(",")) if args.choice_grid else grid,
+        "score": tuple(float(value) for value in args.score_grid.split(",")) if args.score_grid else grid,
+    }
+    records = [json.loads(line) for line in open(PUBLIC) if line.strip()]
+    predictor = entrypoint.load(args.checkpoint, args.device)
+    raw, kinds = [], []
+    with torch.inference_mode():
+        for record in records:
+            prediction = predictor.predict(contract.clean_request(record))
+            question_id, question = next(iter(record["questions"].items()))
+            raw.append([prediction["probabilities"][question_id][key] for key in contract.option_keys(question)])
+            kinds.append(question["type"])
+
+    def report(values):
+        temperatures = dict(zip(TYPES, values))
+        transformed = []
+        for probabilities, kind in zip(raw, kinds):
+            powered = [max(value, 1e-30) ** (1 / temperatures[kind]) for value in probabilities]
+            total = sum(powered)
+            transformed.append([value / total for value in powered])
+        metrics = contract.score_records(records, [response(record, values) for record, values in zip(records, transformed)])
+        return {
+            "multipliers": temperatures,
+            "reward": metrics["reward"],
+            "macro_nll": metrics["macro_nll"],
+            "knowledge_nll": metrics["groups"]["knowledge"]["nll"],
+            "other_nll": metrics["groups"]["other"]["nll"],
+            "unknown": metrics.get("unknowable"),
+        }
+
+    if args.optimize:
+        from scipy.optimize import minimize
+
+        if not 0 < args.opt_min < args.opt_max:
+            raise ValueError("optimization bounds must be positive and increasing")
+        bounds = [(math.log(args.opt_min), math.log(args.opt_max))] * len(TYPES)
+        optimum = minimize(lambda logs: report(tuple(math.exp(value) for value in logs))["macro_nll"],
+                           [0.0] * len(TYPES), method="Nelder-Mead",
+                           bounds=bounds, options={"xatol": 1e-7, "fatol": 1e-10, "maxiter": 500})
+        print(json.dumps({"optimizer": {
+            "success": bool(optimum.success),
+            "iterations": int(optimum.nit),
+            "message": str(optimum.message),
+        }, "result": report(tuple(math.exp(value) for value in optimum.x))}, indent=2))
+        return
+
+    reports = []
+    for values in itertools.product(*(grids[kind] for kind in TYPES)):
+        reports.append(report(values))
+    reports.sort(key=lambda report: report["macro_nll"])
+    print(json.dumps(reports[:12], indent=2))
+
+
+if __name__ == "__main__":
+    main()

