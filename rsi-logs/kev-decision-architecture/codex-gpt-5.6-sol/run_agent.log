+++ b/experiments/build_fifth_variant.py
@@ -0,0 +1,57 @@
+"""Build a five-adapter candidate checkpoint from the selected four-adapter artifact."""
+
+import argparse
+import json
+from pathlib import Path
+import shutil
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--base", required=True)
+    parser.add_argument("--expert", required=True)
+    parser.add_argument("--out", required=True)
+    parser.add_argument("--choice-temperature", required=True, type=float)
+    parser.add_argument("--choice-weight", required=True, type=float)
+    args = parser.parse_args()
+
+    base = Path(args.base)
+    expert = Path(args.expert)
+    out = Path(args.out)
+    if out.exists():
+        raise FileExistsError(out)
+    if not 0 <= args.choice_weight <= 1 or not 0 < args.choice_temperature < 100:
+        raise ValueError("invalid fifth-expert configuration")
+
+    shutil.copytree(base, out)
+    shutil.copytree(expert, out / "fifth_adapter",
+                    ignore=shutil.ignore_patterns("head.pt", "manifest.json", "README.md",
+                                                  "chat_template.jinja", "tokenizer.json",
+                                                  "tokenizer_config.json", "training_config.json",
+                                                  "training_metrics.json"))
+    shutil.copy2(expert / "head.pt", out / "fifth_head.pt")
+
+    manifest_path = out / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    manifest["ensemble"]["fifth"] = {
+        "adapter": "fifth_adapter",
+        "head": "fifth_head.pt",
+        "temperatures": {
+            "noul": 1.9998727475448234,
+            "choice": args.choice_temperature,
+            "score": 4.416046470750526,
+        },
+        "expert_weights": {"noul": 0.0, "choice": args.choice_weight, "score": 0.0},
+    }
+    manifest["checkpoint_files"] = sorted(
+        str(path.relative_to(out)) for path in out.rglob("*") if path.is_file()
+        and path.name != "manifest.json")
+    manifest["checkpoint_files"].append("manifest.json")
+    manifest["checkpoint_files"].sort()
+    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
+    for path in out.rglob("*"):
+        path.chmod(0o755 if path.is_dir() else 0o644)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/cardinality_temperature_probe.py b/experiments/cardinality_temperature_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..7cf5f7a82daf354a697de380400014773b6e8e1b
--- /dev/null
+++ b/experiments/cardinality_temperature_probe.py
@@ -0,0 +1,98 @@
+"""Probe choice-temperature multipliers by option-count bin on public development."""
+
+import argparse
+import importlib.util
+import json
+import sys
+
+import torch
+
+sys.path.insert(0, "/workspace/candidate")
+import entrypoint
+
+spec = importlib.util.spec_from_file_location("public_contract", "/opt/kev-runtime/contract.py")
+contract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(contract)
+
+PUBLIC = "/opt/kev-assets/public/development.jsonl"
+BINS = ("2", "3-5", "6-8", "9+")
+
+
+def choice_bin(question):
+    if question["type"] != "choice":
+        return None
+    count = len(question["criteria"])
+    if count == 2:
+        return "2"
+    if count <= 5:
+        return "3-5"
+    if count <= 8:
+        return "6-8"
+    return "9+"
+
+
+def response(record, probabilities):
+    question_id, question = next(iter(record["questions"].items()))
+    return {"probabilities": {question_id: dict(zip(contract.option_keys(question), probabilities))}}
+
+
+def transform(probabilities, multiplier):
+    powered = [max(value, 1e-30) ** (1 / multiplier) for value in probabilities]
+    total = sum(powered)
+    return [value / total for value in powered]
+
+
+def score(records, raw, kinds, multipliers):
+    values = [transform(probabilities, multipliers[kind]) if kind else probabilities
+              for probabilities, kind in zip(raw, kinds)]
+    return contract.score_records(records, [response(record, probabilities)
+                                             for record, probabilities in zip(records, values)])
+
+
+def summary(label, multipliers, metrics):
+    return {
+        "label": label,
+        "multipliers": multipliers,
+        "reward": metrics["reward"],
+        "macro_nll": metrics["macro_nll"],
+        "knowledge_nll": metrics["groups"]["knowledge"]["nll"],
+        "other_nll": metrics["groups"]["other"]["nll"],
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint")
+    parser.add_argument("--grid", default="0.6,0.75,0.9,1,1.1,1.25,1.5")
+    parser.add_argument("--device", default="cuda:0")
+    args = parser.parse_args()
+    grid = tuple(float(value) for value in args.grid.split(","))
+    records = [json.loads(line) for line in open(PUBLIC) if line.strip()]
+    predictor = entrypoint.load(args.checkpoint, args.device)
+    raw, kinds = [], []
+    with torch.inference_mode():
+        for record in records:
+            prediction = predictor.predict(contract.clean_request(record))
+            question_id, question = next(iter(record["questions"].items()))
+            raw.append([prediction["probabilities"][question_id][key] for key in contract.option_keys(question)])
+            kinds.append(choice_bin(question))
+
+    baseline = {kind: 1.0 for kind in BINS}
+    best = dict(baseline)
+    reports = []
+    for kind in BINS:
+        candidates = []
+        for value in grid:
+            multipliers = dict(baseline)
+            multipliers[kind] = value
+            metrics = score(records, raw, kinds, multipliers)
+            candidates.append(summary(kind, multipliers, metrics))
+        candidates.sort(key=lambda report: report["macro_nll"])
+        best[kind] = candidates[0]["multipliers"][kind]
+        reports.append({"bin": kind, "best": candidates[:3]})
+    reports.append({"combined": summary("combined", best, score(records, raw, kinds, best))})
+    print(json.dumps(reports, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/ensemble_probe.py b/experiments/ensemble_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c8918f5468b196627a20cddb1bff18b0832d65e
--- /dev/null
+++ b/experiments/ensemble_probe.py
@@ -0,0 +1,95 @@
+"""Public-development probability mixture for two independently trained checkpoints."""
+
+import argparse
+import gc
+import importlib.util
+import itertools
+import json
+import sys
+
+import torch
+
+sys.path.insert(0, "/workspace/candidate")
+import entrypoint
+
+spec = importlib.util.spec_from_file_location("public_contract", "/opt/kev-runtime/contract.py")
+contract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(contract)
+
+PUBLIC = "/opt/kev-assets/public/development.jsonl"
+
+
+def predict(checkpoint, device, records):
+    predictor = entrypoint.load(checkpoint, device)
+    output = []
+    with torch.inference_mode():
+        for record in records:
+            question_id, question = next(iter(record["questions"].items()))
+            result = predictor.predict(contract.clean_request(record))["probabilities"][question_id]
+            output.append([result[key] for key in contract.option_keys(question)])
+    del predictor
+    gc.collect()
+    torch.cuda.empty_cache()
+    print(f"predicted {checkpoint}", flush=True)
+    return output
+
+
+def response(record, values):
+    question_id, question = next(iter(record["questions"].items()))
+    return {"probabilities": {question_id: dict(zip(contract.option_keys(question), values))}}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("left")
+    parser.add_argument("right")
+    parser.add_argument("--right-weights", default="0,0.05,0.1,0.15,0.2,0.3,0.4,0.5")
+    parser.add_argument("--type-grid", default="",
+                        help="optional grid for independent noul/choice/score weights")
+    parser.add_argument("--only-type", choices=("noul", "choice", "score"), default="")
+    parser.add_argument("--geometric", action="store_true")
+    parser.add_argument("--device", default="cuda:0")
+    args = parser.parse_args()
+    weights = [float(value) for value in args.right_weights.split(",")]
+    records = [json.loads(line) for line in open(PUBLIC) if line.strip()]
+    left = predict(args.left, args.device, records)
+    right = predict(args.right, args.device, records)
+    reports = []
+    if args.type_grid:
+        grid = [float(value) for value in args.type_grid.split(",")]
+        settings = [dict(zip(("noul", "choice", "score"), values)) for values in itertools.product(grid, repeat=3)]
+    else:
+        settings = [
+            {kind: (weight if not args.only_type or kind == args.only_type else 0.0)
+             for kind in ("noul", "choice", "score")}
+            for weight in weights
+        ]
+    for setting in settings:
+        mixed = []
+        for record, x, y in zip(records, left, right):
+            _, question = next(iter(record["questions"].items()))
+            weight = setting[question["type"]]
+            if args.geometric:
+                values = [max(a, 1e-30) ** (1 - weight) * max(b, 1e-30) ** weight
+                          for a, b in zip(x, y)]
+                total = sum(values)
+                mixed.append([value / total for value in values])
+            else:
+                mixed.append([(1 - weight) * a + weight * b for a, b in zip(x, y)])
+        metrics = contract.score_records(records, [response(record, values) for record, values in zip(records, mixed)])
+        reports.append({
+            "right_weights": setting,
+            "mixture": "geometric" if args.geometric else "arithmetic",
+            "reward": metrics["reward"],
+            "macro_nll": metrics["macro_nll"],
+            "knowledge_nll": metrics["groups"]["knowledge"]["nll"],
+            "other_nll": metrics["groups"]["other"]["nll"],
+            "knowledge_accuracy": metrics["groups"]["knowledge"]["accuracy"],
+            "other_accuracy": metrics["groups"]["other"]["accuracy"],
+        })
+    reports.sort(key=lambda report: report["macro_nll"])
+    print(json.dumps(reports[:20] if args.type_grid else reports, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/interpolate_checkpoints.py b/experiments/interpolate_checkpoints.py
new file mode 100644
index 0000000000000000000000000000000000000000..ceda02bdff5593f4976a5feb44e18ca71b65a362
--- /dev/null
+++ b/experiments/interpolate_checkpoints.py
@@ -0,0 +1,111 @@
+"""Create one aligned LoRA/pointer checkpoint by linear weight interpolation."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+import shutil
+
+from safetensors import safe_open
+from safetensors.torch import load_file, save_file
+import torch
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--left", required=True)
+    parser.add_argument("--right", required=True)
+    parser.add_argument("--right-weight", required=True, type=float)
+    parser.add_argument("--method", choices=("factor", "delta_concat", "head_concat"), default="factor")
+    parser.add_argument("--out", required=True)
+    args = parser.parse_args()
+    if not math.isfinite(args.right_weight) or not 0 <= args.right_weight <= 1:
+        raise ValueError("right-weight must be in [0, 1]")
+
+    left, right, out = map(Path, (args.left, args.right, args.out))
+    if out.exists():
+        raise FileExistsError(out)
+    shutil.copytree(left, out)
+
+    left_adapter = load_file(left / "adapter_model.safetensors")
+    right_adapter = load_file(right / "adapter_model.safetensors")
+    if left_adapter.keys() != right_adapter.keys():
+        raise ValueError("adapter keys differ")
+    alpha = args.right_weight
+    mixed_adapter = {}
+    for key, value in left_adapter.items():
+        other = right_adapter[key]
+        if value.shape != other.shape:
+            raise ValueError(f"adapter shape differs for {key}")
+        if args.method in ("factor", "head_concat"):
+            mixed_adapter[key] = value.mul(1 - alpha).add(other, alpha=alpha)
+        elif key.endswith("lora_A.weight"):
+            mixed_adapter[key] = torch.cat((value, other), dim=0)
+        elif key.endswith("lora_B.weight"):
+            mixed_adapter[key] = torch.cat((value.mul(1 - alpha), other.mul(alpha)), dim=1)
+        else:
+            raise ValueError(f"unsupported adapter tensor for delta concatenation: {key}")
+    with safe_open(left / "adapter_model.safetensors", framework="pt") as stream:
+        metadata = stream.metadata()
+    save_file(mixed_adapter, out / "adapter_model.safetensors", metadata=metadata)
+
+    left_head = torch.load(left / "head.pt", map_location="cpu", weights_only=True)
+    right_head = torch.load(right / "head.pt", map_location="cpu", weights_only=True)
+    if left_head["head"].keys() != right_head["head"].keys():
+        raise ValueError("head keys differ")
+    for key, value in left_head["head"].items():
+        other = right_head["head"][key]
+        if args.method != "head_concat" and value.shape != other.shape:
+            raise ValueError(f"head shape differs for {key}")
+        if args.method == "factor":
+            left_head["head"][key] = value.mul(1 - alpha).add(other, alpha=alpha)
+        elif args.method == "delta_concat":
+            # PointerHead divides by sqrt(width). Scale each concatenated block
+            # so its dot product retains the desired convex logit weight.
+            width_ratio = math.sqrt(2.0)
+            left_scale = math.sqrt((1 - alpha) * width_ratio)
+            right_scale = math.sqrt(alpha * width_ratio)
+            left_head["head"][key] = torch.cat((value.mul(left_scale), other.mul(right_scale)), dim=0)
+        else:
+            if value.shape[1:] != other.shape[1:]:
+                raise ValueError(f"head input shape differs for {key}")
+            left_width = int(left_head["head_dim"])
+            right_width = int(right_head["head_dim"])
+            total_width = left_width + right_width
+            left_scale = math.sqrt((1 - alpha) * math.sqrt(total_width / left_width))
+            right_scale = math.sqrt(alpha * math.sqrt(total_width / right_width))
+            left_head["head"][key] = torch.cat((value.mul(left_scale), other.mul(right_scale)), dim=0)
+    if args.method == "delta_concat":
+        left_head["lora"] = int(left_head["lora"]) * 2
+        left_head["head_dim"] = int(left_head["head_dim"]) * 2
+    elif args.method == "head_concat":
+        left_head["head_dim"] = int(left_head["head_dim"]) + int(right_head["head_dim"])
+    left_head["interpolation"] = {
+        "method": args.method,
+        "right_weight": alpha,
+        "left": str(left),
+        "right": str(right),
+    }
+    torch.save(left_head, out / "head.pt")
+
+    manifest_path = out / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    manifest["training"]["interpolation"] = left_head["interpolation"]
+    if args.method == "delta_concat":
+        config_path = out / "adapter_config.json"
+        config = json.loads(config_path.read_text())
+        config["r"] = int(config["r"]) * 2
+        config["lora_alpha"] = int(config["lora_alpha"]) * 2
+        config_path.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
+        hyperparameters = manifest["training"]["hyperparameters"]
+        hyperparameters["lora"] = int(hyperparameters["lora"]) * 2
+        hyperparameters["head_dim"] = int(hyperparameters["head_dim"]) * 2
+    elif args.method == "head_concat":
+        manifest["training"]["hyperparameters"]["head_dim"] = int(left_head["head_dim"])
+    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
+    for path in out.rglob("*"):
+        path.chmod(0o755 if path.is_dir() else 0o644)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/experiments/package_ensemble.py b/experiments/package_ensemble.py
new file mode 100644
index 0000000000000000000000000000000000000000..2975a0a2db807b05e4cc806e7c3148e8c520d5ac
--- /dev/null
+++ b/experiments/package_ensemble.py
@@ -0,0 +1,49 @@
+"""Declare an auxiliary adapter/head probability ensemble in a checkpoint manifest."""
+
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("checkpoint")
+    parser.add_argument("--weight", type=float, required=True)
+    parser.add_argument("--noul-weight", type=float)
+    parser.add_argument("--choice-weight", type=float)
+    parser.add_argument("--score-weight", type=float)
+    parser.add_argument("--noul", type=float, required=True)
+    parser.add_argument("--choice", type=float, required=True)
+    parser.add_argument("--score", type=float, required=True)
+    args = parser.parse_args()
+    if not 0 <= args.weight <= 1:
+        raise ValueError("weight must be in [0, 1]")
+    checkpoint = Path(args.checkpoint)
+    manifest_path = checkpoint / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    manifest["ensemble"] = {
+        "method": "shared-backbone switched-adapter probability mixture",
+        "aux_adapter": "aux_adapter",
+        "aux_head": "aux_head.pt",
+        "aux_temperatures": {"noul": args.noul, "choice": args.choice, "score": args.score},
+        "right_weight": args.weight,
+    }
+    type_weights = (args.noul_weight, args.choice_weight, args.score_weight)
+    if any(value is not None for value in type_weights):
+        if any(value is None or not 0 <= value <= 1 for value in type_weights):
+            raise ValueError("all per-type weights must be supplied in [0, 1]")
+        manifest["ensemble"]["right_weight_by_type"] = dict(
+            zip(("noul", "choice", "score"), type_weights))
+    manifest["checkpoint_files"] = sorted(
+        path.relative_to(checkpoint).as_posix()
+        for path in checkpoint.rglob("*")
+        if path.is_file() and path.name != "manifest.json"
+    )
+    temporary = checkpoint / ".manifest.json.tmp"
+    temporary.write_text(json.dumps(manifest, indent=2, allow_nan=False) + "\n")
+    temporary.chmod(0o644)
+    temporary.replace(manifest_path)
+
+
+if __name__ == "__main__":
+    main()
