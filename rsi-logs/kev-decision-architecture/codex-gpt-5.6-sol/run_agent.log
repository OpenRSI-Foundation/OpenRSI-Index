index 0000000000000000000000000000000000000000..ce30085d6b2019051d262c6b8355651b0228a97b
--- /dev/null
+++ b/experiments/base_verbalizer.py
@@ -0,0 +1,115 @@
+"""Read-only public-dev probe for pretrained candidate-correctness directions.
+
+This is an architecture diagnostic, not candidate inference and not training.
+It uses only the supplied original base and public development records.
+"""
+import argparse
+import json
+import math
+import sys
+from collections import defaultdict
+
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+sys.path.insert(0, "/workspace/candidate")
+from kev.api import render, option_text
+
+
+BASE = "/opt/kev-assets/base"
+PUBLIC = "/opt/kev-assets/public/development.jsonl"
+VERBALIZERS = {
+    "yes_no": (" Yes", " No"),
+    "correct_incorrect": (" correct", " incorrect"),
+    "true_false": (" true", " false"),
+}
+
+
+def options(question):
+    if question["type"] == "noul":
+        criteria = question.get("criteria") or {}
+        return [option_text("no", criteria.get("false")), option_text("yes", criteria.get("true"))]
+    if question["type"] == "choice":
+        return [option_text(key, value) for key, value in question["criteria"].items()]
+    return [render(value) for value in question["criteria"]]
+
+
+def prompt(record, question, candidate):
+    return (
+        "Context:\n" + render(record["state"]) +
+        "\n\nQuestion:\n" + render(question["instructions"]) +
+        "\n\nCandidate answer:\n" + candidate +
+        "\n\nIs the candidate answer correct? Answer:"
+    )
+
+
+def softmax(values, temperature=1.0):
+    peak = max(values)
+    weights = [math.exp((value - peak) / temperature) for value in values]
+    total = sum(weights)
+    return [value / total for value in weights]
+
+
+def summarize(records, logits, name, temperature):
+    offset = 0
+    sources = defaultdict(list)
+    unknown = []
+    for record in records:
+        question = next(iter(record["questions"].values()))
+        k = len(options(question))
+        probabilities = softmax(logits[offset:offset + k], temperature)
+        offset += k
+        source = record["_meta"]["source"]
+        if source == "unknowable":
+            unknown.append(max(probabilities))
+            continue
+        if question["type"] == "choice":
+            target = list(question["criteria"]).index(question["label"])
+        else:
+            target = int(question["label"])
+        sources[source].append((-math.log(max(probabilities[target], 1e-9)), int(max(range(k), key=probabilities.__getitem__) == target)))
+    agg = {source: {"nll": sum(x for x, _ in rows) / len(rows), "accuracy": sum(x for _, x in rows) / len(rows)}
+           for source, rows in sorted(sources.items())}
+    knowledge = [agg[x] for x in ("mmlu", "mmlu_pro")]
+    other = [value for key, value in agg.items() if key not in ("mmlu", "mmlu_pro")]
+    knll = sum(x["nll"] for x in knowledge) / len(knowledge)
+    onll = sum(x["nll"] for x in other) / len(other)
+    return {"verbalizer": name, "temperature": temperature, "reward": math.exp(-0.5 * (knll + onll)),
+            "macro_nll": 0.5 * (knll + onll), "knowledge_nll": knll, "other_nll": onll,
+            "knowledge_accuracy": sum(x["accuracy"] for x in knowledge) / len(knowledge),
+            "other_accuracy": sum(x["accuracy"] for x in other) / len(other),
+            "unknown_mean_max": sum(unknown) / len(unknown), "sources": agg}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--batch", type=int, default=64)
+    args = parser.parse_args()
+    records = [json.loads(line) for line in open(PUBLIC) if line.strip()]
+    tokenizer = AutoTokenizer.from_pretrained(BASE, local_files_only=True)
+    tokenizer.pad_token = [REDACTED]
+    model = AutoModelForCausalLM.from_pretrained(BASE, local_files_only=True, torch_dtype=torch.bfloat16,
+                                                  attn_implementation="sdpa").to("cuda:0").eval()
+    token_pairs = {name: tuple(tokenizer(text, add_special_tokens=False).input_ids[0] for text in pair)
+                   for name, pair in VERBALIZERS.items()}
+    all_prompts = []
+    for record in records:
+        question = next(iter(record["questions"].values()))
+        all_prompts.extend(prompt(record, question, candidate) for candidate in options(question))
+    results = {name: [] for name in VERBALIZERS}
+    with torch.inference_mode():
+        for start in range(0, len(all_prompts), args.batch):
+            encoded = tokenizer(all_prompts[start:start + args.batch], padding=True, return_tensors="pt").to("cuda:0")
+            output = model(**encoded).logits
+            last = output[torch.arange(len(encoded.input_ids), device="cuda:0"), encoded.attention_mask.sum(1) - 1]
+            for name, (positive, negative) in token_pairs.items():
+                results[name].extend((last[:, positive] - last[:, negative]).float().cpu().tolist())
+    reports = []
+    for name, values in results.items():
+        for temperature in (0.5, 1.0, 2.0, 4.0):
+            reports.append(summarize(records, values, name, temperature))
+    print(json.dumps(reports, indent=2))
+
+
+if __name__ == "__main__":
+    main()
