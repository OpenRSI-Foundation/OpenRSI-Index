{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011Cf8PFihrQdLF2ATygikeG","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BRi2qAkKcq8xyXDCqggJFu","name":"Bash","input":{"command":"mkdir -p /workspace/trials/diagnostics && cat > /workspace/trials/diagnostics/score_pool.py <<'PYEOF'\n#!/usr/bin/env python3\n\"\"\"Work-owned diagnostic: score every fixed-pool row with the frozen base model.\n\nReproduces the fixed trainer's embedding policy exactly (same prefix construction,\nsame instruction masking, same mean-pool + L2 normalise, same 2048 token [REDACTED] and\nrecords, per row, the base model's positive/negative geometry. No pool row, text,\nlabel, or identity is modified; output is a pure read-only measurement.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\n\nimport numpy as np\nimport pyarrow.parquet as pq\nimport torch\nimport torch.distributed as dist\nimport torch.nn.functional as functional\n\nfrom model_support import load_base\n\nQUERY_MAX_LENGTH = 2048\nPASSAGE_MAX_LENGTH = 2048\nBASE_BOS = \"<s>\"\nUSER_BOS = \"<|user|>\\n\"\nUSER_EOS = \"\"\nEMBED_BOS = \"\\n<|embed|>\\n\"\n\n\ndef format_embedding_pair(instruction: str, text: str) -> tuple[str, str]:\n    clean = instruction[: QUERY_MAX_LENGTH * 10].strip(\"\\t\\n :\")\n    prefix = BASE_BOS + USER_BOS + clean + USER_EOS + EMBED_BOS if clean else BASE_BOS + EMBED_BOS.lstrip()\n    return prefix + text[: QUERY_MAX_LENGTH * 10], prefix\n\n\ndef tokenize_pairs(tokenizer, pairs, maximum):\n    sentences, instruction_lens = [], []\n    for instruction, text in pairs:\n        sentence, prefix = format_embedding_pair(instruction, text)\n        sentences.append(sentence)\n        instruction_lens.append(len(tokenizer.tokenize(prefix)))\n    encoded = tokenizer(sentences, padding=True, truncation=True, max_length=maximum,\n                        return_tensors=\"pt\", add_special_tokens=False)\n    encoded[\"instruction_lens\"] = torch.tensor(instruction_lens, dtype=torch.long)\n    return encoded\n\n\n@torch.no_grad()\ndef encode_batch(model, encoded, device):\n    instruction_lens = encoded[\"instruction_lens\"]\n    inputs = {k: v.to(device, non_blocking=True) for k, v in encoded.items() if k != \"instruction_lens\"}\n    inputs[\"is_causal\"] = False\n    with torch.autocast(device_type=\"cuda\", dtype=torch.bfloat16):\n        output = model(**inputs)[0]\n    mask = inputs[\"attention_mask\"].clone()\n    for index, length in enumerate(instruction_lens):\n        length = int(length)\n        if length < mask.shape[1]:\n            mask[index, :length] = 0\n        if not bool(mask[index].sum()):          # degenerate: keep final token\n            mask[index, -1] = 1\n    summed = torch.sum(output * mask.unsqueeze(-1).float(), dim=1)\n    embedding = summed / mask.sum(dim=1, keepdim=True).float()\n    return functional.normalize(embedding, dim=-1).float()\n\n\ndef encode_field(model, tokenizer, pairs, maximum, device, token_budget, log_prefix, rank):\n    \"\"\"Length-sorted micro-batching with a token [REDACTED]; returns embeddings in input order.\"\"\"\n    approx = np.array([len(i) + len(t) for i, t in pairs])\n    order = np.argsort(approx, kind=\"stable\")\n    out = torch.zeros(len(pairs), 4096, dtype=torch.float32)\n    cursor, done = 0, 0\n    while cursor < len(order):\n        width = max(1, int(approx[order[cursor]] // 3.5) + 32)\n        size = max(1, min(64, token_budget // max(width, 1)))\n        chunk = order[cursor: cursor + size]\n        encoded = tokenize_pairs(tokenizer, [pairs[i] for i in chunk], maximum)\n        # re-fit if the real tokenised width blew past the estimate\n        real = encoded[\"input_ids\"].shape[1]\n        if real * len(chunk) > token_budget * 3 and len(chunk) > 1:\n            size = max(1, token_budget // max(real, 1))\n            chunk = order[cursor: cursor + size]\n            encoded = tokenize_pairs(tokenizer, [pairs[i] for i in chunk], maximum)\n        out[torch.as_tensor(np.asarray(chunk))] = encode_batch(model, encoded, device).cpu()\n        cursor += len(chunk)\n        done += len(chunk)\n        if rank == 0 and done % 20000 < len(chunk):\n            print(f\"  {log_prefix}: {done}/{len(pairs)}\", flush=True)\n    return out\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--pool\", type=Path, default=Path(\"/opt/reasonir-task/train/pool.parquet\"))\n    parser.add_argument(\"--out\", required=True, type=Path)\n    parser.add_argument(\"--token-budget\", type=int, default=16384)\n    parser.add_argument(\"--limit\", type=int, default=0)\n    args = parser.parse_args()\n\n    dist.init_process_group(\"nccl\")\n    rank, world = dist.get_rank(), dist.get_world_size()\n    device = torch.device(\"cuda\", rank)\n    torch.cuda.set_device(device)\n\n    table = pq.read_table(args.pool).to_pylist()\n    if args.limit:\n        table = table[: args.limit]\n    shard = [table[i] for i in range(rank, len(table), world)]\n    if rank == 0:\n        print(f\"rows={len(table)} shard={len(shard)} world={world}\", flush=True)\n\n    model, tokenizer = load_base(training=False)\n    model.to(device)\n    model.eval()\n\n    queries = [(r[\"query_instruction\"], r[\"query\"]) for r in shard]\n    positives = [(r[\"positive\"][0][\"instruction\"], r[\"positive\"][0][\"text\"]) for r in shard]\n    negatives = [(r[\"negative\"][0][\"instruction\"], r[\"negative\"][0][\"text\"]) for r in shard]\n\n    q = encode_field(model, tokenizer, queries, QUERY_MAX_LENGTH, device, args.token_budget, \"query\", rank)\n    p = encode_field(model, tokenizer, positives, PASSAGE_MAX_LENGTH, device, args.token_budget, \"positive\", rank)\n    n = encode_field(model, tokenizer, negatives, PASSAGE_MAX_LENGTH, device, args.token_budget, \"negative\", rank)\n\n    s_pos = (q * p).sum(dim=1).numpy().astype(np.float32)\n    s_neg = (q * n).sum(dim=1).numpy().astype(np.float32)\n    s_pn = (p * n).sum(dim=1).numpy().astype(np.float32)\n\n    args.out.parent.mkdir(parents=True, exist_ok=True)\n    part = args.out.with_suffix(f\".rank{rank}.npz\")\n    np.savez(part,\n             row_id=np.array([r[\"row_id\"] for r in shard]),\n             source=np.array([r[\"source\"] for r in shard]),\n             s_pos=s_pos, s_neg=s_neg, s_pn=s_pn,\n             q_chars=np.array([len(r[\"query\"]) for r in shard], dtype=np.int32),\n             p_chars=np.array([len(r[\"positive\"][0][\"text\"]) for r in shard], dtype=np.int32),\n             n_chars=np.array([len(r[\"negative\"][0][\"text\"]) for r in shard], dtype=np.int32))\n    print(f\"rank {rank} wrote {part}\", flush=True)\n    dist.barrier()\n    dist.destroy_process_group()\n\n\nif __name__ == \"__main__\":\n    main()\nPYEOF\npython -c \"import ast;ast.parse(open('/workspace/trials/diagnostics/score_pool.py').read());print('syntax ok')\"","description":"Write offline pool difficulty scorer"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":615,"cache_read_input_tokens":67475,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":615},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ddc471af-9d1d-4e5a-8360-478d04adf2fb","uuid":"b992dcbf-db53-455d-a9d4-7e3e46803e1e","request_id":"req_011Cf8PFiEZm4ZsW7BCifnQP"}
