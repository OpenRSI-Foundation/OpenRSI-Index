als/$TRIAL/drift*.jsonl 2>/dev/null | wc -l)\"\n\necho \"waiting for GPUs to drain ...\"\nfor i in $(seq 1 120); do\n  PROCS=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null | wc -l)\n  BUSY=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null \\\n         | awk '$1 > 2048 {n++} END {print n+0}')\n  if [ \"$PROCS\" -eq 0 ] && [ \"$BUSY\" -eq 0 ]; then\n    echo \"  GPUs free after $((i*5))s\"; break\n  fi\n  sleep 5\ndone\n\necho \"== held-out functional eval ==\"\nPYTHONPATH=/opt/reasonir-task/runtime torchrun --standalone --nproc-per-node=4 \\\n  \"$DIAG/score_arms_by_decile.py\" \\\n  --arms t02-label-anchor-filter t13-easy-to-hard-phased \\\n         t14-hard-to-easy-phased t15-hard-primed-probe \\\n  --include-base --per-decile 192 --out \"$OUT\" > \"$LOG\" 2>&1\nRC=$?\necho \"eval exit $RC -> $LOG\"\ntail -20 \"$LOG\"\nif [ $RC -eq 0 ] && [ -f \"$OUT\" ]; then\n  echo\n  echo \"== reading it (registered analysis, pinned before any data existed) ==\"\n  python \"$DIAG/read_arms_by_decile.py\"\nfi\n","structuredPatch":[],"originalFile":null,"userModified":false}}
