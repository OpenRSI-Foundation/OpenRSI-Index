@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Build deterministic, source-normalized lexical-confusability buckets."""
+
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+import re
+
+import pyarrow.parquet as pq
+
+
+POOL = Path("/opt/reasonir-task/train/pool.parquet")
+OUTPUT = Path("/workspace/policy/lexical-confusability.jsonl")
+TOKEN = [REDACTED]
+STOPWORDS = frozenset(
+    "a an the and or of to in on for with is are was were be been being this that "
+    "these those it its as at by from into about over under what which who whom whose "
+    "when where why how do does did can could should would will may might must have has "
+    "had using use find given determine explain answer question example".split()
+)
+
+
+def tokens(text: str) -> set[str]:
+    return set(TOKEN.findall(text.lower())) - STOPWORDS
+
+
+def similarity(query: set[str], document: set[str]) -> float:
+    if not query:
+        return 0.0
+    return len(query & document) / math.sqrt(len(query) * max(1, len(document)))
+
+
+def main() -> None:
+    rows = pq.read_table(POOL).to_pylist()
+    scored: dict[str, list[tuple[float, int, str]]] = {"hq": [], "vl": []}
+    for row in rows:
+        query = tokens(row["query"])
+        positive = tokens(row["positive"][0]["text"])
+        negative = tokens(row["negative"][0]["text"])
+        margin = similarity(query, negative) - similarity(query, positive)
+        scored[row["source"]].append((margin, len(query), row["row_id"]))
+
+    metadata: dict[str, tuple[float, int]] = {}
+    for source in ("hq", "vl"):
+        ordered = sorted(scored[source])
+        count = len(ordered)
+        for rank, (_, _, row_id) in enumerate(ordered):
+            # The primary sort is lexical confusability. Query length and row_id
+            # make the large exact-tie groups deterministic without data leakage.
+            difficulty = rank / (count - 1)
+            bucket = min(4, (5 * rank) // count)
+            metadata[row_id] = (difficulty, bucket)
+
+    temporary = OUTPUT.with_suffix(".tmp")
+    with temporary.open("w", encoding="utf-8") as stream:
+        for row in rows:
+            difficulty, bucket = metadata[row["row_id"]]
+            stream.write(
+                json.dumps(
+                    {"row_id": row["row_id"], "difficulty": difficulty, "bucket": bucket},
+                    separators=(",", ":"),
+                )
+                + "\n"
+            )
+    temporary.replace(OUTPUT)
+
+    for source in ("hq", "vl"):
+        counts = [0] * 5
+        for _, _, row_id in scored[source]:
+            counts[metadata[row_id][1]] += 1
+        print(json.dumps({"source": source, "bucket_counts": counts}, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
