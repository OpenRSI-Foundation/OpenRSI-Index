import re, math
from collections import Counter
import numpy as np
import pyarrow.parquet as pq
STOP=set('a an the and or of to in on for with is are was were be been being this that these those it its as at by from into about over under what which who whom whose when where why how do does did can could should would will may might must have has had using use find given determine explain answer question example'.split())
pat=re.compile(r\"[a-z0-9]+\")
def toks(s): return set(pat.findall(s.lower()))-STOP
def sim(q,d):
    if not q: return 0
    return len(q & d)/math.sqrt(len(q)*max(1,len(d)))
def values(r):
 q=toks(r['query']); p=toks(r['positive'][0]['text']); n=toks(r['negative'][0]['text'])
 ps=sim(q,p); ns=sim(q,n)
 return ns-ps, ps, ns, len(pat.findall(r['query'].lower())), len(pat.findall(r['positive'][0]['text'].lower())), len(pat.findall(r['negative'][0]['text'].lower()))
t=pq.read_table('/opt/reasonir-task/train/pool.parquet').to_pylist()
for src in ['hq','vl']:
 rows=[r for r in t if r['source']==src]
 a=np.array([values(r) for r in rows])
 print('\\n',src)
 for i,label in enumerate(['margin(n-p)','possim','negsim','qlen','plen','nlen']):
  print(label,dict(zip(['min','p01','p10','p25','p50','p75','p90','p99','max','mean'],[float(x) for x in [a[:,i].min(),*np.percentile(a[:,i],[1,10,25,50,75,90,99]),a[:,i].max(),a[:,i].mean()]])))
 order=np.argsort(a[:,0])
 for title,inds in [('easiest',order[:3]),('hardest',order[-3:])]:
  print(title)
  for i in inds:
   r=rows[int(i)]; print(r['row_id'],'margin',round(a[i,0],3),'q',r['query'][:180].replace('\\n',' '),'P',r['positive'][0]['text'][:80].replace('\\n',' '),'N',r['negative'][0]['text'][:80].replace('\\n',' '))
