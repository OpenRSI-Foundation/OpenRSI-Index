+    {"id": "bounded_z_improvement", "op": "clamp", "args": ["z_improvement"], "min": -0.005, "max": 0.005},
+    {"id": "phase_improvement", "op": "where", "args": ["inside_corridor", "bounded_z_improvement", "bounded_xy_improvement"]},
+    {"id": "memory_initialized", "op": "gt", "args": ["episode_progress", "init_threshold"]},
+    {"id": "valid_improvement", "op": "where", "args": ["memory_initialized", "phase_improvement", "zero"]},
+    {"id": "progress_reward", "op": "mul", "args": ["progress_weight", "valid_improvement"]},
+    {"id": "is_centered", "op": "lt", "args": ["xy_distance", "center_threshold"]},
+    {"id": "center_bonus", "op": "where", "args": ["is_centered", "center_weight", "zero"]},
+    {"id": "bonuses", "op": "add", "args": ["engaged", "success"]},
+    {"id": "reward", "op": "add", "args": ["weighted_keypoints", "position_shaping", "progress_reward", "center_bonus", "bonuses"]}
+  ],
