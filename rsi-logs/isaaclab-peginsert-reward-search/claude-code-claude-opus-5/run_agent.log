{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfCFdy4Vxmvs2MXTLMntN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01L4kZTpAgC8KX8RUAxLiHUq","name":"Write","input":{"file_path":"/workspace/research/probe.py","content":"#!/usr/bin/env python3\n\"\"\"CPU-only probe: evaluate a recipe on synthetic states to inspect its reward landscape.\n\nNo GPU, no simulator. Builds the exact input dict that driver_common.install_graph feeds\nthe reward graph, for a peg held upright at a given (dxy, dz) offset from the bore bottom.\n\"\"\"\nimport sys, json, math\nsys.path.insert(0, \"/opt/peginsert_public\")\nimport torch\nfrom reward_graph import load_recipe, Runtime\n\nPEG_D, PEG_H, HOLE_D, HOLE_H = 0.007986, 0.050, 0.0081, 0.025\nKP_OFFSETS = [(-0.5 + i / 3.0) * 0.15 for i in range(4)]  # num_keypoints=4, keypoint_scale=0.15\n\n\ndef make_inputs(dxy, dz, progress=0.5, n=1, tilt=0.0):\n    \"\"\"Peg upright (optionally tilted by `tilt` rad about x), base at hole + (dxy,0,dz).\"\"\"\n    dev = \"cpu\"\n    hole = torch.tensor([[0.6, 0.0, 0.05]] * n)\n    peg = hole + torch.tensor([[dxy, 0.0, dz]] * n)\n    hq = torch.tensor([[1.0, 0.0, 0.0, 0.0]] * n)\n    pq = torch.tensor([[math.cos(tilt / 2), math.sin(tilt / 2), 0.0, 0.0]] * n)\n\n    def rot(q, v):\n        w, x, y, z = q.unbind(-1)\n        vx, vy, vz = v.unbind(-1)\n        t = torch.stack\n        # standard quaternion rotation\n        uvx, uvy, uvz = y * vz - z * vy, z * vx - x * vz, x * vy - y * vx\n        uuvx, uuvy, uuvz = y * uvz - z * uvy, z * uvx - x * uvz, x * uvy - y * uvx\n        return t((vx + 2 * (w * uvx + uuvx), vy + 2 * (w * uvy + uuvy), vz + 2 * (w * uvz + uuvz)), -1)\n\n    kd = 0.0\n    for o in KP_OFFSETS:\n        off = torch.tensor([[0.0, 0.0, o]] * n)\n        kd = kd + torch.linalg.vector_norm((peg + rot(pq, off)) - (hole + rot(hq, off)), dim=-1)\n    kd = kd / len(KP_OFFSETS)\n\n    lat = math.hypot(dxy, 0.0)\n    engaged = float(lat < 0.0025 and dz < HOLE_H * 0.9)\n    success = float(lat < 0.0025 and dz < HOLE_H * 0.04)\n    z3 = torch.zeros((n, 3))\n    z4 = torch.zeros((n, 4))\n    s = lambda v: torch.full((n,), float(v))\n    return {\n        \"peg_position\": peg, \"peg_quaternion\": pq, \"peg_linear_velocity\": z3, \"peg_angular_velocity\": z3,\n        \"hole_position\": hole, \"hole_quaternion\": hq, \"hole_linear_velocity\": z3, \"hole_angular_velocity\": z3,\n        \"fingertip_position\": peg + torch.tensor([[0.0, 0.0, 0.0324]] * n), \"fingertip_quaternion\": z4 + torch.tensor([[1.0, 0, 0, 0]]),\n        \"fingertip_linear_velocity\": z3, \"fingertip_angular_velocity\": z3,\n        \"joint_position\": torch.zeros((n, 7)), \"joint_velocity\": torch.zeros((n, 7)),\n        \"action\": torch.zeros((n, 6)), \"previous_action\": torch.zeros((n, 6)),\n        \"peg_diameter\": s(PEG_D), \"peg_height\": s(PEG_H), \"hole_diameter\": s(HOLE_D), \"hole_height\": s(HOLE_H),\n        \"episode_progress\": s(progress), \"keypoint_distance\": kd, \"engaged\": s(engaged), \"success\": s(success),\n    }\n\n\ndef landscape(path, progress=0.5):\n    recipe = load_recipe(path)\n    print(f\"=== {path}  (epoch {recipe['selected_epoch']}, mem {recipe['memory_size']}) progress={progress}\")\n    hdr = [\"dz\\\\dxy\"] + [f\"{d*1000:6.1f}\" for d in DXY]\n    print(\" \".join(f\"{h:>8}\" for h in hdr))\n    for dz in DZ:\n        row = [f\"{dz*1000:6.1f}\"]\n        for dxy in DXY:\n            rt = Runtime(recipe, torch, 1, \"cpu\")\n            r = rt.evaluate(make_inputs(dxy, dz, progress))\n            row.append(f\"{float(r[0]):8.3f}\")\n        print(\" \".join(f\"{c:>8}\" for c in row))\n\n\nDXY = [0.0, 0.001, 0.0024, 0.005, 0.010, 0.020, 0.050]\nDZ = [0.000, 0.0005, 0.005, 0.015, 0.022, 0.025, 0.035, 0.047, 0.065]\n\nif __name__ == \"__main__\":\n    for p in sys.argv[1:]:\n        landscape(p)\n        print()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_