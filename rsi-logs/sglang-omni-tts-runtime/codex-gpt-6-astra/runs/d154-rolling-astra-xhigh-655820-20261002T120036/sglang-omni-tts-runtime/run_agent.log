   1296      25  0.0       00:28 /bin/bash -c mkdir -p /workspace/research/work /workspace/research/profiles /workspace/research/tests /workspace/research/configuration cat > /workspace/research/hypothesis.md <<'EOF' # H1: park CosyVoice3 speaker-encoder workers between ONNX operations  Preregistered 2026-10-02, after pristine submission agent-1 and before any candidate edit.  The CPU-only CAMPPlus session has 16 intra-op threads and ONNX Runtime's default intra-op spinning. It shares a 16-core lane with the autoregressive scheduler, preprocessing, vocoder dispatch and transport. Spinning workers may consume CPU while waiting, delaying useful CPU dispatch and GPU work. Setting only this session's session.intra_op.allow_spinning to 0 should reduce CPU utilization and increase non-streaming CosyVoice3 requests/s at client concurrency 16. Thread count, model, precision, arithmetic, sampling and conditioning remain unchanged.  Falsification: reject the throughput claim if matched three-seed Work means do not improve, or if CPU usage does not decrease in the steady-state window. Reject equivalence on any unequal speaker embedding in an independent real-reference check. End-to-end validity requires the complete native Judge and all four guards; embedding equality alone does not establish audio or quality equivalence.  Controlled Work order: pristine seed 42, treatment seed 42, treatment seed 43, pristine seed 43, pristine seed 44, treatment seed 44. Each uses a fresh process, fresh compilation caches, all 1,088 native-order English rows, 16 warmups, concurrency 16, max tokens 2048 and unmodified benchmark defaults. Work uses the stock diagnostic ASR; Judge adds authoritative original-source ASR. No repetition is selected or dropped. OS process/thread sampling accompanies both conditions. Additional tests cover concurrent embeddings, failure followed by successful inference, input immutability and existing request/abort cleanup contracts.  The prior protocol-v2 spinning result (about 9.34 to 13.44 requests/s; CPU about 15.7 to 2.8 cores; 32 equal embeddings) is motivation only, not v4 evidence. Its strict WER failure and noisy unchanged-model guards are retained as limitations. The reported historical MOSS +3.3% experiment is not reproduced or scored here.  Pristine agent-1 was complete and valid-but-ineligible, not a score of 1. Baseline generation 0 is owned by the operator. Its exact source digest and all available baseline means are archived in submissions/agent-1-report-0.json. No Work record promotes or replaces the frozen baseline. EOF cat > /workspace/research/run_work.py <<'PY' """Run one stock Work diagnostic with fresh caches and process CPU sampling.""" import argparse import hashlib import json import os from pathlib import Path import subprocess import sys import time  import psutil  parser = argparse.ArgumentParser() parser.add_argument('label') parser.add_argument('seed', type=int, choices=(42,43,44)) arguments = parser.parse_args() output_directory = Path('/workspace/research/work') / arguments.label output_directory.mkdir(exist_ok=False) cache_directory = Path('/tmp/tts-research-cache') / arguments.label cache_directory.mkdir(parents=True, exist_ok=False) environment = os.environ.copy() for variable, folder in {     'XDG_CACHE_HOME':'xdg', 'TORCHINDUCTOR_CACHE_DIR':'inductor',     'TRITON_CACHE_DIR':'triton', 'CUDA_CACHE_PATH':'cuda',     'FLASHINFER_WORKSPACE_BASE':'flashinfer', 'TMPDIR':'tmp',     'TORCH_EXTENSIONS_DIR':'torch_extensions', }.items():     location = cache_directory / folder     location.mkdir()     environment[variable] = str(location) environment['PYTHONDONTWRITEBYTECODE'] = '1' command = [sys.executable, '-m', 'benchmarks.eval.benchmark_tts_seedtts',     '--model', 'FunAudioLLM/Fun-CosyVoice3-0.5B-2512',     '--meta', 'zhaochenyang20/seed-tts-eval-arrow', '--lang', 'en',     '--max-concurrency', '16', '--warmup', '16', '--max-new-tokens', '2048',     '--seed', str(arguments.seed), '--port', '8000',     '--output-dir', str(output_directory / 'results')] source_path = Path('/workspace/sglang-omni/sglang_omni/models/fun_cosyvoice3/utils.py') manifest = {'label':arguments.label, 'seed':arguments.seed, 'command':command,     'cwd':'/workspace/sglang-omni', 'diagnostic_only':True,     'asr':'stock diagnostic ASR, not authoritative Judge ASR',     'environment':{name:environment.get(name) for name in (         'CUDA_VISIBLE_DEVICES','HF_HOME','HF_HUB_CACHE','HF_DATASETS_CACHE',         'PYTHONPATH','PYTHONDONTWRITEBYTECODE','HF_HUB_OFFLINE',         'HF_DATASETS_OFFLINE','TRANSFORMERS_OFFLINE','XDG_CACHE_HOME',         'TORCHINDUCTOR_CACHE_DIR','TRITON_CACHE_DIR','CUDA_CACHE_PATH',         'FLASHINFER_WORKSPACE_BASE','TMPDIR','TORCH_EXTENSIONS_DIR')},     'affinity':sorted(os.sched_getaffinity(0)),     'source_file_sha256':hashlib.sha256(source_path.read_bytes()).hexdigest(),     'treatment_present':'option.add_session_config_entry("session.intra_op.allow_spinning", "0")' in source_path.read_text(),     'started_unix':time.time()} (output_directory/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n') with (output_directory/'benchmark.log').open('w') as stdout_file, (output_directory/'resources.jsonl').open('w') as samples_file:     process = subprocess.Popen(command, cwd=manifest['cwd'], env=environment, stdout=stdout_file, stderr=subprocess.STDOUT)     root_process = psutil.Process(process.pid)     while process.poll() is None:         try:             descendants = [root_process] + root_process.children(recursive=True)         except psutil.NoSuchProcess:             descendants = []         process_samples = []         for descendant in descendants:             try:                 with descendant.oneshot():                     process_samples.append({'pid':descendant.pid, 'name':descendant.name(),                         'command':descendant.cmdline(), 'cpu':list(descendant.cpu_times()),                         'rss_bytes':descendant.memory_info().rss,                         'threads':[list(thread) for thread in descendant.threads()]})             except (psutil.NoSuchProcess, psutil.AccessDenied):                 continue         samples_file.write(json.dumps({'unix':time.time(),'processes':process_samples})+'\n')         samples_file.flush()         time.sleep(1)     manifest.update(exit_code=process.returncode, finished_unix=time.time()) (output_directory/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n') print(json.dumps(manifest),flush=True) sys.exit(process.returncode) PY python /workspace/research/run_work.py h1-pristine-42 42 > /workspace/research/work/h1-pristine-42-launch.log 2>&1
