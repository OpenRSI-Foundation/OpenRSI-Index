if len(work_records)==6:
    groups={condition:sorted([run for run in work_records if run['condition']==condition],key=lambda run:run['seed']) for condition in ['pristine','parked']}
    assert all([run['seed'] for run in runs]==[42,43,44] for runs in groups.values())
    means={condition:{metric:sum(run['metrics'][metric] for run in runs)/3 for metric in runs[0]['metrics']} for condition,runs in groups.items()}
    summary['means']=means
    summary['comparisons']={metric:{'pristine':baseline,'parked':means['parked'][metric],'delta':means['parked'][metric]-baseline,'relative_delta':(means['parked'][metric]-baseline)/baseline if baseline else None} for metric,baseline in means['pristine'].items()}
    summary['cpu_cores_means']={condition:sum(run['mean_cpu_cores'] for run in runs)/3 for condition,runs in groups.items()}
(root/'work-ablation.json').write_text(json.dumps(summary,indent=2)+'\\n')
