import json
from pathlib import Path
import shutil
import sys

submission=sys.argv[1]
root=Path('/workspace/research/submissions')
log=Path('/run/rsi-harness/feedback')/f'{submission}.log'
shutil.copy2(log,root/log.name)
reports=[]
for line in log.read_text().splitlines():
    if not line.startswith('{'):
        continue
    try:
        record=json.loads(line)
    except json.JSONDecodeError:
        continue
    if 'status' in record and ('runs' in record or 'error' in record):
        reports.append(record)
for index,report in enumerate(reports):
    path=root/f'{submission}-report-{index}.json'
    path.write_text(json.dumps(report,indent=2)+'\\n')
    print(path)
    print('status',report['status'])
    if 'means' in report:
        print('baseline_generation',report['baseline']['generation'])
        print('source_sha256',report['source_sha256'])
        print('progress',report.get('progress'))
        for model,means in report['means'].items():
            print(model,'qps',means['throughput_qps'],'WER',means['wer_corpus'],
                'failed guards',[metric for metric,passed in report['guards'][model].items() if not passed])
if not reports:
    print('No complete aggregate report; inspect archived feedback. Last lines:')
    print('\\n'.join(log.read_text().splitlines()[-35:]))
