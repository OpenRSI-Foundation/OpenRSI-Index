\"\"\"Independently recompute every protocol-v4 comparison from safe feedback.\"\"\"
import json
import math
from pathlib import Path
import sys

report_path=Path(sys.argv[1])
report=json.loads(report_path.read_text())
checks=[]
for model,runs in report['runs'].items():
    assert [run['seed'] for run in runs]==[42,43,44]
    assert len(runs)==3
    for run in runs:
        coverage=run['coverage']
        assert all(coverage[name]==1088 for name in ['asr','tts','wavs'])
        assert coverage['failed']==0 and coverage['skipped']==0
        assert coverage['tts_warmup']==16 and coverage['asr_warmup']==64
    for metric in report['means'][model]:
        mean=sum(run['metrics'][metric] for run in runs)/3
        assert math.isclose(mean,report['means'][model][metric],rel_tol=1e-14,abs_tol=1e-15)
        for comparison_name,baseline_means in [('comparisons',report['baseline']['means']),('initial_comparisons',report['baseline']['initial_means'])]:
            baseline=baseline_means[model][metric]
            comparison=report[comparison_name][model][metric]
            if metric=='wer_corpus':
                passed=mean<=0.02
                threshold=0.02
            elif model=='cosy' and metric=='throughput_qps':
                passed=mean>baseline
                threshold=baseline
            elif metric in ['throughput_qps','audio_throughput_s_per_s']:
                threshold=0.97*baseline
                passed=mean>=threshold
            else:
                threshold=1.03*baseline
                passed=mean<=threshold
            assert passed==comparison['passed']
            assert math.isclose(threshold,comparison['threshold'],rel_tol=1e-14,abs_tol=1e-15)
            assert math.isclose(mean-baseline,comparison['delta'],rel_tol=1e-14,abs_tol=1e-15)
            checks.append({'against':comparison_name,'model':model,'metric':metric,'candidate_mean':mean,'threshold':threshold,'passed':passed})
result={'report':str(report_path),'baseline_generation':report['baseline']['generation'],'recomputed_comparisons':len(checks),'all_recomputed_values_match_feedback':True,'all_current_gates_pass':all(check['passed'] for check in checks if check['against']=='comparisons'),'checks':checks}
report_path.with_name(report_path.stem+'-verified.json').write_text(json.dumps(result,indent=2)+'\\n')
print(json.dumps({name:value for name,value in result.items() if name"'!='"'checks'}))
