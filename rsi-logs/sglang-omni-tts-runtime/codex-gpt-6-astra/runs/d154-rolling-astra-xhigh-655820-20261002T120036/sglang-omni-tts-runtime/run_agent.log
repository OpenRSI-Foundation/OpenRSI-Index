\"\"\"Check all source entries against restoration and archive the closed candidate.\"\"\"
import hashlib
import json
import os
from pathlib import Path
import tarfile

root=Path('/workspace/research')
source=Path('/workspace/sglang-omni')
restoration=Path('/opt/rsi-source')
inventories={}
for label,directory in [('pristine',restoration),('candidate',source)]:
    entries={}
    for current,folders,files in os.walk(directory,followlinks=False):
        for name in sorted(folders+files):
            path=Path(current)/name
            relative=str(path.relative_to(directory))
            if path.is_symlink():
                entries[relative]={'kind':'symlink','target':os.readlink(path)}
            elif path.is_file():
                contents=path.read_bytes()
                entries[relative]={'kind':'file','size':len(contents),'sha256':hashlib.sha256(contents).hexdigest(),'mode':path.stat().st_mode & 0o777}
            else:
                entries[relative]={'kind':'directory','mode':path.stat().st_mode & 0o777}
    inventories[label]=entries
    (root/f'{label}-file-manifest.json').write_text(json.dumps(entries,sort_keys=True,indent=2)+'\\n')
changed=[path for path in sorted(set(inventories['pristine'])|set(inventories['candidate'])) if inventories['pristine'].get(path)"'!=inventories['"'candidate'].get(path)]
assert changed==['sglang_omni/models/fun_cosyvoice3/utils.py'],changed
assert not any('__pycache__' in path or path.endswith('.pyc') or '.pytest_cache' in path for path in inventories['candidate'])
archives={}
for label,directory in [('pristine',restoration),('candidate',source)]:
    archive_path=root/f'{label}-source.tar.gz'
    if label=='pristine' and archive_path.exists():
        pass
    else:
        with tarfile.open(archive_path,'w:gz',dereference=False) as archive:
            archive.add(directory,arcname='sglang-omni')
    archives[label]={'path':str(archive_path),'sha256':hashlib.sha256(archive_path.read_bytes()).hexdigest()}
result={'changed_paths':changed,'all_other_entries_pristine':True,'source_cache_artifacts_absent':True,'archives':archives,'authority_note':'Per-file inventory and archive hashes are research evidence; operator evaluated source_sha256 is retained separately.'}
(root/'source-integrity.json').write_text(json.dumps(result,indent=2)+'\\n')
print(json.dumps(result,indent=2))
