{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "method", "include_sources", "replacement", "seed"],
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$"},
    "method": {"enum": ["uniform", "weighted", "easy-to-hard", "hard-to-easy", "bucket-curriculum"]},
    "include_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["hq", "vl"]}},
    "replacement": {"const": true},
    "seed": {"const": 42},
    "scores_file": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.jsonl$"},
    "curriculum_phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["until_update", "min_bucket", "max_bucket"],
        "properties": {
          "until_update": {"type": "integer", "minimum": 1, "maximum": 1000},
          "min_bucket": {"type": "integer", "minimum": 0, "maximum": 99},
          "max_bucket": {"type": "integer", "minimum": 0, "maximum": 99}
        }
      }
    }
  }
}
