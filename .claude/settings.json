              "${CLAUDE_PROJECT_DIR}/.agents/skills/proposal-agent/scripts/proposal_session.py",
              "hook",
              "--platform",
              "claude-code",
              "--checkout",
              "${CLAUDE_PROJECT_DIR}"
            ]
          }
        ]
